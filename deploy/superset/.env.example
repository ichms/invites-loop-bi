# Copy to .env (gitignored) and fill in. Generate secrets like:
#   openssl rand -base64 32        # passwords
#   openssl rand -base64 42        # SUPERSET_SECRET_KEY

# --- Superset application database (its OWN storage, not the warehouse) ----
SS_DB_DBNAME=superset_app
SS_DB_USER=superset
SS_DB_PASS=

# Flask secret; also encrypts stored warehouse credentials. Changing it later
# ORPHANS every stored secret — keep it with the backups.
SUPERSET_SECRET_KEY=

# --- first admin user (created by superset-init, idempotent) ---------------
SS_ADMIN_USER=admin
SS_ADMIN_EMAIL=admin@localhost
SS_ADMIN_PASSWORD=

# --- warehouse connection, registered automatically by superset-init -------
# superset_reader is created by sql/01_superset_reader_role.sql; its password
# lives in the password manager. Leave SS_DW_HOST/SS_DW_PASSWORD empty to skip
# auto-registration.
SS_DW_HOST=
SS_DW_PORT=5432
SS_DW_DBNAME=invites_dw
SS_DW_USER=superset_reader
SS_DW_PASSWORD=

# --- server ----------------------------------------------------------------
SS_HOST_PORT=8088
